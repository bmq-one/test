# E-Mail Agent Konfiguration
# Kopiere diese Datei nach config.yaml und passe die Werte an

# E-Mail Einstellungen (IMAP)
email:
  # IMAP Server (z.B. imap.gmail.com, imap.outlook.com, imap.web.de)
  imap_server: "imap.gmail.com"
  imap_port: 993

  # Deine E-Mail-Adresse
  email_address: "deine.email@gmail.com"

  # App-Passwort (nicht dein normales Passwort!)
  # Für Gmail: https://myaccount.google.com/apppasswords
  password: "dein-app-passwort"

  # SMTP für Antworten senden
  smtp_server: "smtp.gmail.com"
  smtp_port: 587

  # Ordner zum Überwachen
  inbox_folder: "INBOX"

  # Maximale Anzahl E-Mails pro Durchlauf
  max_emails_per_run: 20

# Claude API Einstellungen
anthropic:
  # API Key von https://console.anthropic.com/
  api_key: "sk-ant-xxxxx"

  # Modell (claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307)
  model: "claude-sonnet-4-20250514"

  # Maximale Tokens für Antworten
  max_tokens: 2048

# Wissensbasis Einstellungen
knowledge_base:
  # Verzeichnis für deine Wissensdokumente
  documents_path: "./knowledge"

  # Embedding-Modell für semantische Suche
  embedding_model: "all-MiniLM-L6-v2"

  # ChromaDB Persistenz-Verzeichnis
  chroma_path: "./chroma_db"

  # Anzahl relevanter Dokumente für Kontext
  top_k_results: 5

# Agent Einstellungen
agent:
  # Name des Agenten (erscheint in Antworten)
  name: "Email-Assistent"

  # Dein Name (für personalisierte Antworten)
  user_name: "Max Mustermann"

  # Sprache für Antworten
  language: "de"

  # Automatisch Antworten senden (false = nur Entwürfe erstellen)
  auto_send: false

  # E-Mail-Adressen ignorieren (z.B. Newsletter)
  ignore_addresses:
    - "newsletter@example.com"
    - "noreply@example.com"

  # Betreff-Muster ignorieren (Regex)
  ignore_subjects:
    - "^\\[Newsletter\\]"
    - "^Werbung:"

# Scheduler Einstellungen
scheduler:
  # Tägliche Ausführungszeit (24h Format)
  run_time: "08:00"

  # Zeitzone
  timezone: "Europe/Berlin"

# Logging
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  file: "./logs/email_agent.log"
