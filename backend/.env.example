# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_newsletter?schema=public"

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Claude API (Alternative zu OpenAI)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Newsletter Configuration
NEWSLETTER_FREQUENCY=daily
MAX_ARTICLES_PER_NEWSLETTER=10

# AI Style Configuration (wird in DB gespeichert, aber kann hier als Default gesetzt werden)
AI_TONE=professional_but_accessible
AI_TARGET_AUDIENCE=AI_enthusiasts_and_developers
